.light .navbar { background-color: rgba(248, 249, 252, 0.9); }
.nav-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); }
.nav-logo { font-family: var(--font-family-display); font-weight: 700; font-size: var(--text-xl); letter-spacing: var(--tracking-tight); color: var(--color-text-primary); text-decoration: none; transition: color var(--transition-duration-fast) ease; }
.nav-logo:hover { color: var(--color-accent); } .nav-logo span { color: var(--color-accent); }
.nav-links { display: flex; align-items: center; gap: var(--space-6); list-style: none; font-weight: 500; font-size: var(--text-sm); }
.nav-links a { color: var(--color-text-secondary); text-decoration: none; padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); transition: var(--transition-fast); position: relative; }
.nav-links a:hover { color: var(--color-accent); background: var(--color-surface); }
.nav-links a::after { content: ''; position: absolute; bottom: -2px; left: 50%; width: 0; height: 2px; background: var(--color-accent); border-radius: var(--radius-full); transition: var(--transition-fast); transform: translateX(-50%); }
.nav-links a:hover::after { width: 60%; }
#theme-toggle { background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-secondary); padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); font-size: var(--text-sm); cursor: pointer; transition: var(--transition-fast); font-family: var(--font-family-base); font-weight: 500; min-height: 36px; display: flex; align-items: center; gap: var(--space-1); }
#theme-toggle:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-dim); }
.hamburger { display: none; background: none; border: none; color: var(--color-text-primary); font-size: 1.5rem; cursor: pointer; padding: var(--space-2); }

/* Progress */
.progress-bar { position: fixed; top: 0; left: 0; height: 4px; background: var(--color-accent); width: 0%; z-index: 9999; transition: width 0.1s linear; border-radius: 0 var(--radius-full) var(--radius-full) 0; }
.progress-bar.hidden { opacity: 0; }
.progress-circle { width: 48px; height: 48px; border-radius: var(--radius-full); background: conic-gradient(var(--color-accent) calc(var(--progress) * 1%), var(--color-border) 0); display: flex; align-items: center; justify-content: center; font-size: var(--text-xs); font-weight: 600; color: var(--color-text-primary); }
.progress-track { width: 100%; height: 8px; background: var(--color-border); border-radius: var(--radius-full); overflow: hidden; }
.progress-fill { height: 100%; background: var(--color-accent); border-radius: var(--radius-full); transition: width var(--transition-duration-slow) var(--ease-out); }

/* Radar Chart */
.radar-chart { display: flex; justify-content: center; align-items: center; }
.radar-chart canvas { max-width: 100%; height: auto; }
.radar-chart svg { width: 100%; height: auto; }
.radar-label { font-size: var(--text-xs); fill: var(--color-text-secondary); font-family: var(--font-family-base); }
.radar-grid { stroke: var(--color-border); fill: none; }
.radar-grid-fill { fill: var(--color-accent-dim); stroke: var(--color-accent); stroke-width: 1.5; opacity: 0.3; }

/* Scrollbar */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(--color-surface); }
::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: var(--radius-full); transition: background var(--transition-duration-fast) ease; }
::-webkit-scrollbar-thumb:hover { background: var(--color-accent); }
[id] { scroll-margin-top: 80px; }

/* Search */
.search-box { position: relative; }
.search-box input { width: 100%; padding: var(--space-2) var(--space-4); background: var(--color-background); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-primary); font-size: var(--text-sm); outline: none; transition: var(--transition-fast); }
.search-box input::placeholder { color: var(--color-text-placeholder); }
.search-box input:focus { border-color: var(--color-accent); box-shadow: var(--focus-ring); }
.search-box .search-icon { position: absolute; left: var(--space-3); top: 50%; transform: translateY(-50%); color: var(--color-text-tertiary); pointer-events: none; }
.search-box .search-icon + input { padding-left: var(--space-8); }
.search-results { position: absolute; top: 100%; left: 0; right: 0; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); margin-top: var(--space-1); box-shadow: var(--shadow-lg); z-index: var(--z-index-dropdown); max-height: 240px; overflow-y: auto; display: none; }
.search-box.active .search-results { display: block; }
.search-result-item { padding: var(--space-2) var(--space-4); font-size: var(--text-sm); color: var(--color-text-primary); cursor: pointer; transition: var(--transition-fast); }
.search-result-item:hover { background: var(--color-accent-dim); color: var(--color-accent); }

/* Social Sidebar */
.social-sidebar { position: fixed; left: var(--space-4); top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: var(--space-3); z-index: var(--z-index-raised); }
.social-sidebar a { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-full); background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-secondary); text-decoration: none; transition: var(--transition-fast); }
.social-sidebar a:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-dim); transform: translateY(-2px); box-shadow: var(--shadow-md); }

/* Tag */
.tag { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-0_5) var(--space-2_5); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 500; line-height: var(--leading-none); background: var(--color-accent-dim); color: var(--color-accent); border: 1px solid transparent; cursor: pointer; transition: var(--transition-fast); text-decoration: none; white-space: nowrap; }
.tag:hover { background: var(--color-accent); color: var(--color-background); border-color: var(--color-accent); }
.tag-outline { background: transparent; border-color: var(--color-border); color: var(--color-text-secondary); }
.tag-outline:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-dim); }
.tag-sm { padding: var(--space-0_5) var(--space-2); font-size: 0.65rem; } .tag-lg { padding: var(--space-1) var(--space-4); font-size: var(--text-sm); }

/* Terminal */
.terminal { background: var(--color-background); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; font-family: var(--font-family-mono); font-size: var(--text-sm); color: var(--color-text-primary); box-shadow: var(--shadow-lg); }
.terminal-header { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
.terminal-dot { width: 12px; height: 12px; border-radius: var(--radius-full); }
.terminal-dot.red { background: var(--color-error); } .terminal-dot.yellow { background: var(--color-warning); } .terminal-dot.green { background: var(--color-success); }
.terminal-title { margin-left: auto; font-size: var(--text-xs); color: var(--color-text-tertiary); }
.terminal-body { padding: var(--space-4); line-height: var(--leading-loose); overflow-x: auto; }
.terminal-line { display: flex; gap: var(--space-2); margin-bottom: var(--space-1); }
.terminal-prompt { color: var(--color-accent); font-weight: 600; white-space: nowrap; }
.terminal-command { color: var(--color-text-primary); }
.terminal-output { color: var(--color-text-secondary); margin-bottom: var(--space-2); }
.terminal-cursor { display: inline-block; width: 8px; height: 1.2em; background: var(--color-accent); margin-left: 2px; animation: blink 1s step-end infinite; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

/* Timeline */
.timeline { position: relative; padding-left: var(--space-8); }
.timeline::before { content: ''; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--color-border); }
.timeline-item { position: relative; margin-bottom: var(--space-6); }
.timeline-item:last-child { margin-bottom: 0; }
.timeline-item::before { content: ''; position: absolute; left: -20px; top: 4px; width: 12px; height: 12px; border-radius: var(--radius-full); background: var(--color-accent); border: 2px solid var(--color-background); }
.timeline-item-content { padding-bottom: var(--space-4); }
.timeline-item-date { font-size: var(--text-xs); color: var(--color-text-tertiary); font-family: var(--font-family-mono); margin-bottom: var(--space-1); }
.timeline-item-title { font-weight: 600; font-size: var(--text-base); color: var(--color-text-primary); margin-bottom: var(--space-1); }
.timeline-item-description { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: var(--leading-snug); }

/* Toast */
.toast-container { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; gap: var(--space-3); z-index: var(--z-index-toast); pointer-events: none; }
.toast { padding: var(--space-3) var(--space-6); border-radius: var(--radius-md); background: var(--color-surface-raised); border: 1px solid var(--color-border); color: var(--color-text-primary); font-size: var(--text-sm); box-shadow: var(--shadow-lg); animation: slideUp 0.3s ease, fadeOut 0.3s 2.5s ease forwards; pointer-events: auto; max-width: 90vw; white-space: nowrap; }
.toast-success { border-color: var(--color-success); color: var(--color-success); background: var(--color-success-dim); }
.toast-error { border-color: var(--color-error); color: var(--color-error); background: var(--color-error-dim); }
.toast-warning { border-color: var(--color-warning); color: var(--color-warning); background: var(--color-warning-dim); }
.toast-info { border-color: var(--color-info); color: var(--color-info); background: var(--color-info-dim); }

/* Tooltip */
[data-tooltip] { position: relative; cursor: help; }
[data-tooltip]::after { content: attr(data-tooltip); position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%) translateY(-4px); white-space: nowrap; background: var(--color-surface-raised); color: var(--color-text-primary); padding: var(--space-1) var(--space-2_5); border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-size: var(--text-xs); font-family: var(--font-family-base); font-weight: 400; line-height: var(--leading-normal); box-shadow: var(--shadow-md); opacity: 0; pointer-events: none; transition: opacity var(--transition-duration-fast) var(--ease-out), transform var(--transition-duration-fast) var(--ease-out); z-index: var(--z-index-tooltip); }
[data-tooltip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(-8px); }
[data-tooltip-pos="top"]::after { bottom: 100%; left: 50%; transform: translateX(-50%) translateY(-4px); }
[data-tooltip-pos="top"]:hover::after { transform: translateX(-50%) translateY(-8px); }
[data-tooltip-pos="bottom"]::after { bottom: auto; top: 100%; transform: translateX(-50%) translateY(4px); }
[data-tooltip-pos="bottom"]:hover::after { transform: translateX(-50%) translateY(8px); }
[data-tooltip-pos="left"]::after { bottom: auto; top: 50%; left: auto; right: 100%; transform: translateY(-50%) translateX(-4px); }
[data-tooltip-pos="left"]:hover::after { transform: translateY(-50%) translateX(-8px); }
[data-tooltip-pos="right"]::after { bottom: auto; top: 50%; left: 100%; transform: translateY(-50%) translateX(4px); }
[data-tooltip-pos="right"]:hover::after { transform: translateY(-50%) translateX(8px); }

/* ============================================
   13. PAGES
   ============================================ */
/* Blog */
.blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-6); padding-top: var(--space-20); padding-bottom: var(--space-20); }
.blog-card { background: var(--card-background); border: var(--card-border); border-radius: var(--card-border-radius); overflow: hidden; transition: var(--transition-base); display: flex; flex-direction: column; }
.blog-card:hover { border-color: var(--color-accent-dim); transform: translateY(-4px); box-shadow: var(--card-shadow); }
.blog-card-image { width: 100%; height: 200px; object-fit: cover; border-bottom: 1px solid var(--color-border); }
.blog-card-body { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
.blog-card-tag { display: inline-flex; align-items: center; gap: var(--space-1); font-family: var(--font-family-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--color-accent); background: var(--color-accent-dim); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); width: fit-content; }
.blog-card-title { font-weight: 700; font-size: var(--text-xl); line-height: var(--leading-snug); color: var(--color-text-primary); }
.blog-card-title a { text-decoration: none; color: inherit; } .blog-card-title a:hover { color: var(--color-accent); }
.blog-card-excerpt { color: var(--color-text-secondary); font-size: var(--text-sm); line-height: var(--leading-relaxed); flex: 1; }
.blog-card-meta { padding-top: var(--space-3); border-top: 1px solid var(--color-border); display: flex; align-items: center; justify-content: space-between; font-size: var(--text-xs); color: var(--color-text-tertiary); }
.blog-card-meta .author { display: flex; align-items: center; gap: var(--space-2); }
.blog-card-meta .author-avatar { width: 24px; height: 24px; border-radius: var(--radius-full); background: var(--color-accent-dim); border: 1px solid var(--color-accent); }
.blog-card.featured { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; }
.blog-card.featured .blog-card-image { height: 100%; }
.pagination { display: flex; justify-content: center; gap: var(--space-2); margin-top: var(--space-12); }
.pagination a, .pagination span { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: var(--radius-md); text-decoration: none; font-size: var(--text-sm); font-weight: 500; transition: var(--transition-fast); color: var(--color-text-secondary); background: var(--color-surface); border: 1px solid var(--color-border); }
.pagination a:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-dim); }
.pagination .active { background: var(--color-accent); color: var(--color-background); border-color: var(--color-accent); }
.pagination .disabled { opacity: var(--opacity-disabled); pointer-events: none; }

/* Contact */
.contact-form { max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-4); }
.contact-form input, .contact-form textarea { width: 100%; padding: var(--space-3) var(--space-4); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-primary); font-family: var(--font-family-base); font-size: var(--text-sm); outline: none; transition: var(--transition-fast); }
.contact-form input::placeholder, .contact-form textarea::placeholder { color: var(--color-text-placeholder); }
.contact-form input:focus, .contact-form textarea:focus { border-color: var(--color-accent); box-shadow: var(--focus-ring); }
.contact-form textarea { min-height: 150px; resize: vertical; }
.contact-form button { align-self: flex-start; }

/* Current Focus */
.current-focus { text-align: center; padding-top: var(--space-20); }
.current-focus h1 { margin-bottom: var(--space-4); }
.current-focus .focus-description { color: var(--color-text-secondary); font-size: var(--text-lg); max-width: 600px; margin: 0 auto var(--space-8); }
.current-focus .next-focus { font-size: var(--text-sm); color: var(--color-text-tertiary); margin-top: var(--space-6); }
.current-focus .next-focus strong { color: var(--color-accent); }

/* Projects */
.project-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-6); padding-top: var(--space-20); padding-bottom: var(--space-20); }
.project-card { background: var(--card-background); border: var(--card-border); border-radius: var(--card-border-radius); overflow: hidden; transition: var(--transition-base); display: flex; flex-direction: column; }
.project-card:hover { border-color: var(--color-accent-dim); transform: translateY(-4px); box-shadow: var(--card-shadow); }
.project-card-image { width: 100%; height: 200px; object-fit: cover; border-bottom: 1px solid var(--color-border); }
.project-card-body { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
.project-card-title { font-weight: 700; font-size: var(--text-xl); line-height: var(--leading-snug); color: var(--color-text-primary); }
.project-card-description { color: var(--color-text-secondary); font-size: var(--text-sm); line-height: var(--leading-relaxed); flex: 1; }
.project-card-links { display: flex; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
.project-card-links a { font-size: var(--text-sm); color: var(--color-accent); text-decoration: none; font-weight: 500; transition: color var(--transition-duration-fast) ease; }
.project-card-links a:hover { color: var(--color-accent-hover); }
.project-filters { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-8); }
.project-filter { padding: var(--space-1) var(--space-4); border-radius: var(--radius-full); font-size: var(--text-sm); font-weight: 500; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-secondary); cursor: pointer; transition: var(--transition-fast); }
.project-filter:hover, .project-filter.active { background: var(--color-accent-dim); color: var(--color-accent); border-color: var(--color-accent); }

/* ============================================
   14. RESPONSIVE (ALL MEDIA QUERIES)
   ============================================ */
@media (min-width: 640px) { .container { padding: 0 var(--space-6); } }
@media (min-width: 768px) { .container { padding: 0 var(--space-6); } .grid-2 { grid-template-columns: repeat(2, 1fr); } .grid-3 { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .container { padding: 0 var(--space-8); } .grid-3 { grid-template-columns: repeat(3, 1fr); } .sidebar-layout { display: grid; grid-template-columns: 250px 1fr; gap: var(--space-8); } }
@media (min-width: 1280px) { .container { max-width: var(--breakpoint-xl); } }
@media (max-width: 1024px) { .sidebar { display: none; } .social-sidebar { display: none; } }
@media (max-width: 768px) {
  .hero h1 { font-size: var(--text-3xl); }
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  .blog-card.featured { grid-template-columns: 1fr; } .blog-card.featured .blog-card-image { height: 200px; }
  .footer-inner { flex-direction: column; text-align: center; gap: var(--space-4); }
  .footer-links { justify-content: center; }
}
@media (max-width: 767px) {
  .nav-links { display: none; }
  .hamburger { display: block; }
  .hero { padding: var(--space-16) 0 var(--space-12); }
  .hero h1 { font-size: var(--text-3xl); }
  .hero p { font-size: var(--text-base); }
}

