/* ============================================
   BODAMIRUSE DESIGN SYSTEM — Unified Stylesheet
   ============================================ */

/* ============================================
   1. DESIGN TOKENS (PRIMITIVES)
   ============================================ */
:root {
  /* الألوان الأساسية */
  --gray-50: #f9fafb;
  --gray-100: #f3f4f6;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-600: #4b5563;
  --gray-700: #374151;
  --gray-800: #1f2937;
  --gray-900: #111827;
  --gray-950: #030712;
  --photon-50: #f5f3ff;
  --photon-100: #ede9fe;
  --photon-200: #ddd6fe;
  --photon-300: #c4b5fd;
  --photon-400: #a78bfa;
  --photon-500: #8b5cf6;
  --photon-600: #7c3aed;
  --photon-700: #6d28d9;
  --photon-800: #5b21b6;
  --photon-900: #4c1d95;
  --photon-950: #2e1065;
  --green-400: #34d399; --green-950: #022c22;
  --yellow-400: #fbbf24; --yellow-950: #451a03;
  --red-400: #f87171; --red-950: #450a0a;
  --blue-400: #60a5fa; --blue-950: #172554;
  /* المسافات (نظام 4px) */
  --space-0: 0; --space-px: 1px; --space-0_5: 2px; --space-1: 4px; --space-1_5: 6px;
  --space-2: 8px; --space-2_5: 10px; --space-3: 12px; --space-3_5: 14px; --space-4: 16px;
  --space-5: 20px; --space-6: 24px; --space-7: 28px; --space-8: 32px; --space-9: 36px;
  --space-10: 40px; --space-11: 44px; --space-12: 48px; --space-14: 56px; --space-16: 64px;
  --space-20: 80px; --space-24: 96px; --space-28: 112px; --space-32: 128px; --space-36: 144px;
  --space-40: 160px; --space-44: 176px; --space-48: 192px; --space-52: 208px; --space-56: 224px;
  --space-60: 240px; --space-64: 256px; --space-72: 288px; --space-80: 320px; --space-96: 384px;
  --space-n1: -4px; --space-n2: -8px; --space-n3: -12px; --space-n4: -16px; --space-n6: -24px; --space-n8: -32px;
  /* الطباعة */
  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
  --font-display: 'Space Grotesk', var(--font-sans);
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  --text-xs: 0.75rem; --text-sm: 0.875rem; --text-base: 1rem; --text-lg: 1.125rem;
  --text-xl: 1.25rem; --text-2xl: 1.5rem; --text-3xl: 1.875rem; --text-4xl: 2.25rem;
  --text-5xl: 3rem; --text-6xl: 3.75rem; --text-7xl: 4.5rem; --text-8xl: 6rem; --text-9xl: 8rem;
  --leading-none: 1; --leading-tight: 1.15; --leading-snug: 1.35; --leading-normal: 1.6;
  --leading-relaxed: 1.75; --leading-loose: 2;
  --tracking-tighter: -0.05em; --tracking-tight: -0.025em; --tracking-normal: 0em;
  --tracking-wide: 0.025em; --tracking-wider: 0.05em; --tracking-widest: 0.1em;
  /* أنصاف الأقطار */
  --radius-none: 0; --radius-sm: 4px; --radius-base: 6px; --radius-md: 8px;
  --radius-lg: 12px; --radius-xl: 16px; --radius-2xl: 24px; --radius-3xl: 32px; --radius-full: 9999px;
  /* الظلال */
  --shadow-xs: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  --shadow-2xl: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  --shadow-inner: inset 0 2px 4px 0 rgb(0 0 0 / 0.05);
  /* نقاط التحول */
  --breakpoint-sm: 640px; --breakpoint-md: 768px; --breakpoint-lg: 1024px;
  --breakpoint-xl: 1280px; --breakpoint-2xl: 1536px;
  --container-query-sm: 40ch; --container-query-md: 60ch; --container-query-lg: 80ch;
  /* الطبقات */
  --z-index-below: -1; --z-index-base: 0; --z-index-raised: 10; --z-index-dropdown: 100;
  --z-index-sticky: 200; --z-index-overlay: 300; --z-index-modal: 400; --z-index-popover: 500;
  --z-index-tooltip: 600; --z-index-toast: 700; --z-index-top: 9999;
  /* الحركة */
  --transition-duration-instant: 0ms; --transition-duration-fast: 150ms; --transition-duration-base: 250ms;
  --transition-duration-slow: 350ms; --transition-duration-slower: 500ms;
  --ease-linear: cubic-bezier(0, 0, 1, 1); --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-out: cubic-bezier(0, 0, 0.2, 1); --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --transition-fast: all var(--transition-duration-fast) var(--ease-out);
  --transition-base: all var(--transition-duration-base) var(--ease-in-out);
  --transition-slow: all var(--transition-duration-slow) var(--ease-in);
  --transition-bounce: all var(--transition-duration-slower) var(--ease-bounce);
  /* ----- 2. SEMANTICS (داكن افتراضي) ----- */
  --color-background: var(--gray-950); --color-background-raised: #0D1117;
  --color-background-inverse: var(--gray-50); --color-surface: #151820;
  --color-surface-raised: #1C2030; --color-surface-inverse: var(--gray-200);
  --color-border: #242840; --color-border-strong: #3D4A6B;
  --color-text-primary: #DCE0F0; --color-text-secondary: #7888A0;
  --color-text-tertiary: #4A4560; --color-text-inverse: #1A1D2E; --color-text-placeholder: #4A4560;
  --color-accent: var(--photon-400); --color-accent-hover: var(--photon-300);
  --color-accent-active: var(--photon-500); --color-accent-dim: #1A1535;
  --color-success: var(--green-400); --color-success-dim: var(--green-950);
  --color-warning: var(--yellow-400); --color-warning-dim: var(--yellow-950);
  --color-error: var(--red-400); --color-error-dim: var(--red-950);
  --color-info: var(--blue-400); --color-info-dim: var(--blue-950);
  /* المسافات الدلالية */
  --spacing-component-padding: var(--space-4); --spacing-component-gap: var(--space-2);
  --spacing-section-gap: var(--space-16); --spacing-section-padding: var(--space-12);
  --spacing-container-padding: var(--space-4); --spacing-stack-sm: var(--space-2);
  --spacing-stack-base: var(--space-4); --spacing-stack-lg: var(--space-8);
  /* الطباعة الدلالية */
  --font-family-base: var(--font-sans); --font-family-display: var(--font-display);
  --font-family-mono: var(--font-mono);
  --text-body: var(--text-base); --text-body-small: var(--text-sm);
  --text-body-large: var(--text-lg); --text-heading: var(--text-2xl); --text-display: var(--text-5xl);
  --border-radius-element: var(--radius-md); --border-radius-card: var(--radius-lg);
  --border-radius-modal: var(--radius-xl); --shadow-element: var(--shadow-sm);
  --shadow-card: var(--shadow-md); --shadow-modal: var(--shadow-xl);
  /* ----- 3. COMPONENT TOKENS ----- */
  --button-background: var(--color-accent); --button-background-hover: var(--color-accent-hover);
  --button-color: var(--color-background); --button-padding-x: var(--space-4);
  --button-padding-y: var(--space-2); --button-font-size: var(--text-sm);
  --button-font-weight: 600; --button-border-radius: var(--border-radius-element); --button-gap: var(--space-2);
  --card-background: var(--color-surface); --card-border: 1px solid var(--color-border);
  --card-border-radius: var(--border-radius-card); --card-padding: var(--spacing-component-padding);
  --card-shadow: var(--shadow-card); --card-title-font-size: var(--text-xl); --card-title-font-weight: 700;
  --input-background: var(--color-surface); --input-border: 1px solid var(--color-border);
  --input-border-radius: var(--radius-md); --input-padding: var(--space-3) var(--space-4);
  --input-font-size: var(--text-sm); --input-min-height: 44px;
  --container-max-width: var(--breakpoint-2xl); --container-padding: var(--space-4);
  --opacity-disabled: 0.5; --opacity-hover: 0.8; --opacity-overlay: 0.6;
  --focus-ring: 0 0 0 3px var(--color-accent-dim), 0 0 0 1px var(--color-accent);
  --print-font-size: 12pt;
  /* ----- 4. COSMIC TOKENS ----- */
  --cosmic-deep: #0a0a1a; --cosmic-surface: #12122a; --cosmic-card: #1a1a3e;
  --cosmic-border: #2a2a5a; --cosmic-glow: #7b68ee; --cosmic-accent: #a78bfa;
  --cosmic-star: #e0c3fc; --cosmic-nebula-1: #6b21a8; --cosmic-nebula-2: #3b82f6;
  --cosmic-nebula-3: #10b981; --cosmic-text: #e2e8f0; --cosmic-muted: #94a3b8;
  --cosmic-radius: 16px; --cosmic-blur: 16px;
}

/* ============================================
   5. LIGHT THEME OVERRIDES
   ============================================ */
.light {
  --color-background: var(--gray-50); --color-background-raised: #F8F9FC;
  --color-background-inverse: var(--gray-900); --color-surface: #FFFFFF;
  --color-surface-raised: #F2F4FA; --color-surface-inverse: var(--gray-300);
  --color-border: #D4D8EC; --color-border-strong: #A0AACB;
  --color-text-primary: #1A1D2E; --color-text-secondary: #4A5580;
  --color-text-tertiary: #9AA0B8; --color-text-inverse: #DCE0F0; --color-text-placeholder: #9AA0B8;
  --color-accent: #7C6DF0; --color-accent-hover: #A99BFF; --color-accent-active: #6D28D9;
  --color-accent-dim: #EEEAFF; --color-success: #22A67B; --color-success-dim: #D1FAE5;
  --color-warning: #D97706; --color-warning-dim: #FEF3C7;
  --color-error: #DC2626; --color-error-dim: #FEE2E2;
  --color-info: #2563EB; --color-info-dim: #DEEAFE;
  --shadow-xs: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.06), 0 1px 2px -1px rgb(0 0 0 / 0.06);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.07);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.08);
  --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.08);
  --shadow-2xl: 0 25px 50px -12px rgb(0 0 0 / 0.15);
  --shadow-inner: inset 0 2px 4px 0 rgb(0 0 0 / 0.04);
}

/* ============================================
   6. RESET & BASE
   ============================================ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
body {
  font-family: var(--font-family-base); background-color: var(--color-background);
  color: var(--color-text-primary); line-height: var(--leading-normal);
  transition: background-color var(--transition-duration-base) ease, color var(--transition-duration-base) ease;
  min-height: 100vh; font-size: var(--text-base);
}
img, video, canvas { max-width: 100%; display: block; }
input, button, textarea, select { font: inherit; color: inherit; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; }

/* ============================================
   7. TYPOGRAPHY
   ============================================ */
h1, h2, h3, h4, h5, h6 { font-family: var(--font-family-display); line-height: var(--leading-tight); color: var(--color-text-primary); }
h1 { font-size: var(--text-5xl); } h2 { font-size: var(--text-3xl); } h3 { font-size: var(--text-2xl); }
h4 { font-size: var(--text-xl); } h5 { font-size: var(--text-lg); } h6 { font-size: var(--text-base); }
p { margin-bottom: var(--space-4); line-height: var(--leading-normal); }
strong, b { font-weight: 600; color: var(--color-text-primary); }
em, i { font-style: italic; }
small { font-size: var(--text-sm); }
blockquote {
  border-left: 4px solid var(--color-accent); padding: var(--space-4) var(--space-6);
  margin: var(--space-6) 0; background: var(--color-accent-dim);
  border-radius: 0 var(--radius-md) var(--radius-md) 0; font-style: italic; color: var(--color-text-primary);
}
code { font-family: var(--font-family-mono); background: var(--color-surface); padding: var(--space-0_5) var(--space-1_5); border-radius: var(--radius-sm); font-size: 0.9em; }
pre { font-family: var(--font-family-mono); background: var(--color-background); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-6); overflow-x: auto; line-height: var(--leading-loose); }
pre code { background: none; padding: 0; border-radius: 0; }
a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; transition: color var(--transition-duration-fast) ease; }
a:hover { color: var(--color-accent-hover); }
ul, ol { padding-left: var(--space-6); margin-bottom: var(--space-4); }
ul { list-style-type: disc; } ol { list-style-type: decimal; }
li { margin-bottom: var(--space-2); }

/* ============================================
   8. UTILITIES (COLORS, EFFECTS, SPACING, TYPOGRAPHY, VISIBILITY)
   ============================================ */
.text-primary { color: var(--color-text-primary); } .text-secondary { color: var(--color-text-secondary); }
.text-tertiary { color: var(--color-text-tertiary); } .text-inverse { color: var(--color-text-inverse); }
.text-accent { color: var(--color-accent); } .text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); } .text-error { color: var(--color-error); }
.text-info { color: var(--color-info); } .text-photon { color: var(--color-accent); }
.bg-background { background-color: var(--color-background); } .bg-surface { background-color: var(--color-surface); }
.bg-surface-raised { background-color: var(--color-surface-raised); } .bg-accent { background-color: var(--color-accent); }
.bg-accent-dim { background-color: var(--color-accent-dim); } .bg-success { background-color: var(--color-success); }
.bg-success-dim { background-color: var(--color-success-dim); } .bg-warning { background-color: var(--color-warning); }
.bg-warning-dim { background-color: var(--color-warning-dim); } .bg-error { background-color: var(--color-error); }
.bg-error-dim { background-color: var(--color-error-dim); } .bg-info { background-color: var(--color-info); }
.bg-info-dim { background-color: var(--color-info-dim); }
.border-accent { border-color: var(--color-accent); } .border-success { border-color: var(--color-success); }
.border-warning { border-color: var(--color-warning); } .border-error { border-color: var(--color-error); }
.border-info { border-color: var(--color-info); }
.hover-lift { transition: var(--transition-base); } .hover-lift:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.hover-glow:hover { box-shadow: 0 0 20px var(--color-accent-dim); } .hover-scale:hover { transform: scale(1.02); }
.shadow-none { box-shadow: none; } .shadow-sm { box-shadow: var(--shadow-sm); } .shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); } .shadow-xl { box-shadow: var(--shadow-xl); }
.backdrop-blur { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
.opacity-0 { opacity: 0; } .opacity-50 { opacity: 0.5; } .opacity-100 { opacity: 1; }
.transition-fast { transition: var(--transition-fast); } .transition-base { transition: var(--transition-base); } .transition-slow { transition: var(--transition-slow); }
/* SPACING */
.m-0 { margin: var(--space-0); } .m-1 { margin: var(--space-1); } .m-2 { margin: var(--space-2); } .m-3 { margin: var(--space-3); }
.m-4 { margin: var(--space-4); } .m-5 { margin: var(--space-5); } .m-6 { margin: var(--space-6); } .m-8 { margin: var(--space-8); }
.m-10 { margin: var(--space-10); } .m-12 { margin: var(--space-12); } .m-16 { margin: var(--space-16); }
.mt-4 { margin-top: var(--space-4); } .mt-6 { margin-top: var(--space-6); } .mt-8 { margin-top: var(--space-8); }
.mt-10 { margin-top: var(--space-10); } .mt-12 { margin-top: var(--space-12); } .mt-20 { margin-top: var(--space-20); }
.mb-4 { margin-bottom: var(--space-4); } .mb-6 { margin-bottom: var(--space-6); } .mb-8 { margin-bottom: var(--space-8); }
.mb-10 { margin-bottom: var(--space-10); } .mb-12 { margin-bottom: var(--space-12); }
.p-0 { padding: var(--space-0); } .p-1 { padding: var(--space-1); } .p-2 { padding: var(--space-2); }
.p-3 { padding: var(--space-3); } .p-4 { padding: var(--space-4); } .p-5 { padding: var(--space-5); }
.p-6 { padding: var(--space-6); } .p-8 { padding: var(--space-8); }
/* TYPOGRAPHY UTILS */
.font-sans { font-family: var(--font-family-base); } .font-display { font-family: var(--font-family-display); }
.font-mono { font-family: var(--font-family-mono); }
.text-xs { font-size: var(--text-xs); } .text-sm { font-size: var(--text-sm); } .text-base { font-size: var(--text-base); }
.text-lg { font-size: var(--text-lg); } .text-xl { font-size: var(--text-xl); } .text-2xl { font-size: var(--text-2xl); }
.text-3xl { font-size: var(--text-3xl); } .text-4xl { font-size: var(--text-4xl); } .text-5xl { font-size: var(--text-5xl); }
.font-light { font-weight: 300; } .font-normal { font-weight: 400; } .font-medium { font-weight: 500; }
.font-semibold { font-weight: 600; } .font-bold { font-weight: 700; } .font-extrabold { font-weight: 800; }
.text-center { text-align: center; } .text-left { text-align: left; } .text-right { text-align: right; }
.uppercase { text-transform: uppercase; } .lowercase { text-transform: lowercase; } .capitalize { text-transform: capitalize; }
.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* VISIBILITY */
.hidden { display: none; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
.invisible { visibility: hidden; } .visible { visibility: visible; }
@media (min-width: 640px) { .visible-sm { display: block; } .hidden-sm { display: none; } }
@media (min-width: 768px) { .visible-md { display: block; } .hidden-md { display: none; } }
@media (min-width: 1024px) { .visible-lg { display: block; } .hidden-lg { display: none; } }
@media (min-width: 1280px) { .visible-xl { display: block; } .hidden-xl { display: none; } }

/* ============================================
   9. LAYOUT (CONTAINER, GRID, SIDEBAR, FOOTER)
   ============================================ */
.container { width: 100%; max-width: var(--container-max-width); margin: 0 auto; padding: 0 var(--container-padding); }
.grid { display: grid; gap: var(--space-6); }
.grid-2 { grid-template-columns: repeat(2, 1fr); } .grid-3 { grid-template-columns: repeat(3, 1fr); } .grid-4 { grid-template-columns: repeat(4, 1fr); }
.grid-auto-sm { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
.grid-auto-md { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.grid-auto-lg { grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); }
.sidebar { position: sticky; top: 80px; align-self: start; max-height: calc(100vh - 100px); overflow-y: auto; }
.sidebar-section { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); margin-bottom: var(--space-4); }
.sidebar-section:last-child { margin-bottom: 0; }
.sidebar-section h3 { font-size: var(--text-sm); font-weight: 600; color: var(--color-text-secondary); margin-bottom: var(--space-3); text-transform: uppercase; letter-spacing: var(--tracking-wide); }
.sidebar-section ul { list-style: none; padding: 0; margin: 0; }
.sidebar-section li { margin-bottom: var(--space-2); } .sidebar-section li:last-child { margin-bottom: 0; }
.sidebar-section a { display: block; padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); color: var(--color-text-secondary); font-size: var(--text-sm); text-decoration: none; transition: var(--transition-fast); }
.sidebar-section a:hover, .sidebar-section a.active { color: var(--color-accent); background: var(--color-accent-dim); }
.footer { padding: var(--space-12) 0 var(--space-8); border-top: 1px solid var(--color-border); width: 100%; }
.footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-6); }
.footer-meta { font-size: var(--text-xs); color: var(--color-text-tertiary); }
.footer-links { display: flex; gap: var(--space-6); list-style: none; font-size: var(--text-sm); }
.footer-links a { color: var(--color-text-secondary); text-decoration: none; transition: color var(--transition-duration-fast) ease; }
.footer-links a:hover { color: var(--color-accent); }
.footer-social { display: flex; gap: var(--space-4); }
.footer-social a { color: var(--color-text-tertiary); text-decoration: none; transition: all var(--transition-duration-fast) ease; font-size: var(--text-base); }
.footer-social a:hover { color: var(--color-accent); transform: translateY(-2px); }

/* ============================================
   10. FLEX HELPERS
   ============================================ */
.flex { display: flex; } .flex-col { flex-direction: column; } .flex-wrap { flex-wrap: wrap; }
